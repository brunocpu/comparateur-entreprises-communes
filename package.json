{
  "name": "comparateur-entreprises-communes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Comparer une commune française à dix communes de taille et de profil sectoriel similaires sur les indicateurs Insee de démographie d'entreprises.",
  "scripts": {
    "test": "node --test test/units.mjs test/golden.mjs",
    "test:golden:update": "node test/golden.mjs --update",
    "test:browser": "node --test test/browser.mjs",
    "test:e2e": "node test-pull.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:og": "node scripts/build-og-image.mjs",
    "build:sw-version": "node scripts/compute-sw-version.mjs",
    "check:datasets": "node scripts/check-datasets.mjs",
    "check:millesimes": "node scripts/check-millesimes.mjs"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "wawoff2": "^2.0.1"
  }
}
